# ~/.clauderc_file_structure — Claude-maintained repo registry
# Counterpart to ~/.clauderc (paths/constants) and ~/.clauderc_context (context, TBD).
# Sourced the same way. Mine to edit freely — no permission needed.
#
# Purpose: canonical (local_path, github_url) pairs, one per tracked repo.
# .clauderc's REPO SHORTCUTS section gives quick $VARS for cd/scripts;
# this file is the fuller record — local disk location + remote origin
# together, so a repo's identity doesn't require re-deriving `git remote -v`.

# ============================================================
# AINULINDALE REPO
# local:  /home/rendier/Projects/ThePlace/Ainulindale
# github: https://github.com/michaelrendier/Ainulindale
# ============================================================

export AINULINDALE_REPO_LOCAL="/home/rendier/Projects/ThePlace/Ainulindale"
export AINULINDALE_REPO_GITHUB="https://github.com/michaelrendier/Ainulindale"

# JSON form, for anything that wants to parse rather than split on env vars.
export AINULINDALE_REPO='{"name":"Ainulindale","local":"/home/rendier/Projects/ThePlace/Ainulindale","github":"https://github.com/michaelrendier/Ainulindale"}'

