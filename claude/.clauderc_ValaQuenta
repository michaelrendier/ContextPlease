#!/usr/bin/env bash
# .clauderc_ValaQuenta — per-engine context index for ValaQuenta
# ============================================================================
# Sourced automatically by ~/.bashrc (explicit allowlist, see .bashrc comment).
# Purpose: avoid re-reading ValaQuenta/modules/*/maths.py from scratch every
# session. Each engine module gets ONE bash variable holding a distilled
# summary (claim, engines, confidence tiers, key constants, flagged issues).
# Look it up by name instead of grepping/reading source.
#
# Usage:
#   source .claude/.clauderc_ValaQuenta   # or let ~/.bashrc do it automatically
#   ctxengine tier8_sedenion              # prints that module's context block
#   echo "$VALAQUENTA_ENGINE_INDEX"       # list every available module name
#   ctxengine _crosscutting               # cross-module patterns worth knowing
#
# Design note (why named variables, not line-number indexing like
# .clauderc_context_1's ctxdir()): that file is prose/markdown, so awk-by-
# heading is the only cheap extraction method available. This file is real
# bash -- a directly-addressable variable per engine is strictly simpler and
# more robust than line-range lookups, so that's what's used here instead.
#
# Populated: 2026-07-10, via full-module survey (Explore agent, not a
# surface pass -- every modules/*/maths.py read in full, tools.py checked
# for confidence-tier fidelity against maths.py's own docstrings).
# Regenerate/update when ValaQuenta/modules/ changes meaningfully.
#
# CONFIDENCE TIER KEY (from engine/registry.py):
#   ESTABLISHED = verified by code and/or established mathematics
#   THEORETICAL = defined test/derivation path exists, not fully closed
#   CONJECTURE  = named direction, no formal derivation yet
#   OPEN        = active open problem
#   Many maths.py docstrings use COMPOUND tags, e.g.
#   "ESTABLISHED (X) + THEORETICAL (Y)" -- X is solid, Y is the
#   interpretive/identification layer on top. tools.py sometimes FLATTENS
#   these to a single tier -- see _crosscutting block, item 2.
#
# ============================================================================
# FULL ENGINE PROTOCOL  (amended 2026-08-04 by Cody -- FIVE parts, was four)
# ============================================================================
# An engine is not "done" until all five artifacts exist. Shipping the code
# alone leaves the engine undiscoverable from a cold context, which is the
# failure this whole .clauderc_* family exists to prevent.
#
#   1. ENGINE          ValaQuenta/modules/<name>/{__init__,maths,tools}.py
#                      implementing the engine/registry.py EquationModule
#                      contract, and REGISTERED in ValaQuenta/__main__.py
#                      _register_all() plus listed in modules/__init__.py.
#   2. NOTEBOOK        ValaQuenta/notebooks/engines/NN_<name>.ipynb
#                      (or the topic subdirectory), exercising the formulary
#                      end to end, with the open items shown honestly.
#   3. AINULINDALE WIKI  Ainulindale/wiki/NN_<name>.md -- the narrative page:
#                      origin quote, what changed, honest boundaries,
#                      predecessor links.
#   4. VALAQUENTA WIKI   ValaQuenta/wiki/<name>.md -- the engineering page:
#                      file, class, claim, mechanism, confidence table.
#                      Add the row to wiki/00_index.md.
#   5. .clauderc_ValaQuenta ENTRY  <-- NEW, added 2026-08-04.
#                      export CTX_<NAME>="..." below, AND the module name
#                      appended to VALAQUENTA_ENGINE_INDEX above, so
#                      `ctxengine <name>` resolves without reading source.
#                      An engine absent from this file is invisible to a
#                      cold session no matter how complete its code is --
#                      l_io_photon_path sat unindexed for weeks in exactly
#                      that state (see CTX_L_IO_PHOTON_PATH, "WAS MISSING
#                      FROM THIS INDEX").
#
# A canonical-maths change accompanying an engine also goes in
# ~/.clauderc_canonical_maths, and all ~/.clauderc* files are copied into
# ContextPlease/claude/ before the push (github push protocol).
# ============================================================================

export VALAQUENTA_ENGINE_INDEX="berry_keating clay_millennium constants derivation_chain h_rb_hat hyperwebster inversion jwst lagrangian noether noether_information sigma_cavitation singularity_null sonification spherical tier6_physics tier7_cosmos tier8_sedenion tier9_chem turing_diagonal udeo_crypto sigma_expansion l_io_photon_path archimedes_screw monad translator_discocat translator_vsa translator_common _crosscutting"

ctxengine() {
  local var="CTX_$(echo "$1" | tr '[:lower:]' '[:upper:]')"
  if [ -z "${!var}" ]; then
    echo "no context for '$1' -- available modules:"
    echo "  $VALAQUENTA_ENGINE_INDEX"
    return 1
  fi
  echo "${!var}"
}

