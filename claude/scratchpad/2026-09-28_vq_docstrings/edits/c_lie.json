  "params": {
   "convention": "'physics' or 'math'"
  },
  "returns": "the three generators",
  "raises": {
   "ValueError": "the convention is unknown"
  }
 },
 "su3_generators": {
  "params": {
   "convention": "'physics' or 'math'"
  },
  "returns": "the eight generators",
  "raises": {
   "ValueError": "the convention is unknown"
  }
 },
 "commutator": {
  "params": {
   "A": "first matrix",
   "B": "second matrix"
  },
  "returns": "AB − BA"
 }
}