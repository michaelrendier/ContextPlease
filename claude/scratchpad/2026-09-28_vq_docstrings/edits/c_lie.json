{
 "LieGeneratorConvention": {
  "doc": "Normalisation of Lie generators.\n\n:cvar PHYSICS: Tr(T^a T^b) = ½ δ^{ab}\n:cvar MATH: Tr(T^a T^b) = 2 δ^{ab}"
 },
 "u1_generator": {
  "params": {
   "convention": "'physics' or 'math'"
  },
  "returns": "the 1×1 identity matrix"
 },
