# Non-repo but load-bearing directories (large, not git-tracked)
# Ptolemy2/ and TheWanderingGod/ (~7.1GB combined: vendored sourcebuilds/
# examples + a WordPress export) were deleted 2026-07-08 to free space on
# this device — both remain backed up on the dead laptop's NVMe (in an
# enclosure, not yet readable/powerable from this phone). If ever needed
# again, they must be recovered from that drive, not re-cloned from here.
export DIR_DATASETS="$THEPLACE/DataSets"
export DIR_PDESKTOP="$THEPLACE/PDesktop"            # outreach/disclosure emails (CISA/MITRE/CERT-CC)
export DIR_PHONE_PULL="$THEPLACE/phone_pull_2026-06-06"  # older primer archive, superseded

# ── Directory "maneuvers" ───────────────────────────────────────────────
# Jump helpers. Usage: cdrepo ainulindale
cdrepo() {
  local var="REPO_$(echo "$1" | tr '[:lower:]' '[:upper:]')_PATH"
  local path="${!var}"
  if [ -z "$path" ]; then echo "no repo path var for '$1'"; return 1; fi
  cd "$path" || return 1
}

# ── Per-directory context extraction ────────────────────────────────────
# .clauderc_context_1 holds one authoritative, live-edited entry per
# directory/repo, keyed by a `## RepoName` heading. Pull just one entry
# (cheap, bounded, no need to read the whole growing file) with:
#   ctxdir VAPMIP
ctxdir() {
  awk -v d="## $1" '$0==d{f=1;next} /^## /{f=0} f' \
    "$THEPLACE/.claude/.clauderc_context_1"
}

# ── Exploration: prefer `tree`, not `find` ──────────────────────────────
# Feedback from Cody (2026-07-07): brute-forcing `find` every session is slow
# and noisy. Default to `tree` scoped to what's actually needed, e.g.:
#   tree -L 2 "$THEPLACE"                     # shallow orientation
#   tree -P '*.md|*.py' -I '__pycache__' DIR   # content-filtered
#   tree -J DIR > out.json                     # machine-readable, for grep -o/jq
# .clauderc_file_structure (this directory) is the full `tree -J -I '.git'`
# of all of ThePlace, regenerate it when the tree changes meaningfully:
#   tree -J -I '.git' "$THEPLACE" > "$THEPLACE/.claude/.clauderc_file_structure"
